# 同机部署：保持默认，访问 http://服务器IP:8080。
WEB_PORT=8080
WEB_BIND=0.0.0.0
COLLECTOR_PORT=8787
# 独立收集器需要被另一台服务器访问时改为 0.0.0.0，并在防火墙仅放行前端服务器 IP。
COLLECTOR_BIND=127.0.0.1
# 前端独立部署时改为 http://收集器服务器IP:8787 或 https://收集器域名。
COLLECTOR_UPSTREAM=http://collector:8787
REFRESH_MINUTES=60
# 默认走前端同源反向代理，无需设置跨域。
ALLOWED_ORIGINS=*
# 相对路径以仓库根目录为基准，也可指定绝对路径。
DATA_DIR=./deploy/data
